#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin>>n;
    int count1=0;
    int count2=0;
    while(n--){
        int a,b;
        cin>>a>>b;
        if(a>b)
        count1++;
        else if(b>a)
        count2++;
    }
    if(count1>count2)
    cout<<"Mishka";
    else if(count2>count1)
    cout<<"Chris";
    else if(count1==count2)
    cout<<"Friendship is magic!^^";
}