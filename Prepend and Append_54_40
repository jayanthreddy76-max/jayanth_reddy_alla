#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int n;
    cin>>n;
    while(n--){
        int j;
        cin>>j;
        string s;
        cin>>s;
        int l=0;
        int r=j-1;
        while(l<r && s[l]!=s[r]){
            l++;
            r--;
        }
        cout<<r-l+1<<endl;
    }
}