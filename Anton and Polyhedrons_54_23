#include <bits/stdc++.h>
using namespace std;

int main() {
    int x;
    cin>>x;
    int count=0;
    for(int i=0;i<x;i++)
    {
        string n;
        cin>>n;
        if(n=="Tetrahedron")
        count+=4;
        else if(n=="Cube")
        count+=6;
        else if(n=="Octahedron") 
        count+=8;
        else if(n=="Dodecahedron")
        count+=12;
        else if(n=="Icosahedron")
        count+=20;
    }
    cout<<count;
}