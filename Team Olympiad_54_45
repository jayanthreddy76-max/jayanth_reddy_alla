#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin>>n;

    vector<int>v1,v2,v3;
    vector<int> v(n);
 
    for(int i=0;i<n;i++){
        cin >> v[i];

        if(v[i]==1) 
            v1.push_back(i);

        else if(v[i]==2) 
            v2.push_back(i);

        else if(v[i]==3) 
            v3.push_back(i);

    }
        int minimum = min({v1.size(),v2.size(),v3.size()});
        cout<<minimum<<endl;

        for(int i=0;i<minimum;i++){
            cout<<v1[i]+1 << " " <<v2[i]+1 << " "<<v3[i]+1 << endl;
        }
}