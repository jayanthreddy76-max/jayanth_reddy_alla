#include <bits/stdc++.h>
using namespace std;

int main() 
{
    string s1,s2;
    cin>>s1>>s2;
    int count=0;
    int y=s1.size();
    for (int i=0;i<s1.size();i++)
    {
    if(s1[i]==s2[y-(i+1)])
    count++;
    else
    count--;
    }
    if(count==s1.size() && count==s2.size())
    cout<<"YES";
    else
    cout<<"NO";
}