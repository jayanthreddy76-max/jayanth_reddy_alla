#include <bits/stdc++.h>
using namespace std;

int main() {
    string s;
    cin>>s;
    int c1=0;
    int c2=0;
    int c3=0;
    for(int i=0;i<s.size();i++)
    {
        if(s[i]=='1')
        c1++;
        else if(s[i]=='2')
        c2++;
        else if(s[i]=='3')
        c3++;
    }
    for(int i=0;i<s.size();i=i+2)
    {
        if(i==s.size()-1)
        {
            if(c1>0){
                cout<<"1";
                c1--;
            }
            else if(c2>0){
                cout<<"2";
                c2--;
            }
            else if(c3>0){
                cout<<"3";
                c3--;
            }
        }
        else
        {
            if(c1>0){
                cout<<"1+";
                c1--;
            }
            else if(c2>0){
                cout<<"2+";
                c2--;
            }
            else if(c3>0){
                cout<<"3+";
                c3--;
            }
        }
    }
}