#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int n;
    cin>>n;
    while(n--){
        int a;
        cin>>a;
        string s;
        cin>>s;
        s.push_back('#');
        int sum=0;
        int count=0;
        vector<int> v;
        for(int i=0;i<a;i++){
            if(s[i]=='.'){
                sum++;
                count=max(count,sum);
                if(s[i+1]=='#')
                {
                    v.push_back(sum);
                }
            }
            else
            sum=0;
        }
        int ans=0;
        if(count>2)
        cout<<"2"<<endl;
        else{
            for(int i=0;i<v.size();i++){
                if(v[i]==1)
                ans+=1;
                else if(v[i]==2)
                ans+=2;
            }
            cout<<ans<<endl;
        }
    }
}