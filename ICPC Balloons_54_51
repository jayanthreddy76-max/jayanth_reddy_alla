#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int n;
    cin>>n;
    while(n--){
        int a;cin>>a;
        string s;
        cin>>s;
        sort(s.begin(),s.end());
        int count=0;
        for(int i=0;i<a-1;i++){
            if(s[i]==s[i+1])
            count++;
            else 
            count+=2;
        }
        cout<<count+2<<endl;
    }
}