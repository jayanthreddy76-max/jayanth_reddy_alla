#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int n;cin>>n;
    int count=0;
    vector<int> v(n);
    for(int i=0;i<n;i++){
        cin>>v[i];
    }
    int mx=0;
    for(int i=0;i<n;i++){
        mx=max(mx,v[i]);
    }
    for(int i=0;i<n;i++){
        count=count+v[i]-mx;
    }
    if(n==1)
    cout<<"0";
    else if(count>0)
    cout<<count;
    else 
    cout<<-(count);
}