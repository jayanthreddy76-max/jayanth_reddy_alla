#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int n;
    cin>>n;
    while(n--){
        int a;
        cin>>a;
        string s;
        int count=0;
        vector<int> v1,v2;
        for(int i=0;i<a;i++){
            int j;
            cin>>j;
            v1.push_back(j);
            v2.push_back(j);
        }

        sort(v2.begin(),v2.end());
        if(v2[0]==v2[1])
        s.push_back(v2[v2.size()-1]);
        else if(v2[0]!=v2[1])
        s.push_back(v2[0]);
        
        for(int k=0;k<v1.size();k++){
            if(s[0]==v1[k])
            count=k+1;
        }
        cout<<count<<endl;
    }
}